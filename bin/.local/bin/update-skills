#!/usr/bin/env python3

import argparse
import json
import os
from pathlib import Path
import shlex
import shutil
import subprocess
import tempfile


def managed_skills(repo):
    catalog = repo / "agents/.agents/skills"
    central = repo / "agents/skills"
    names = subprocess.check_output(
        ["git", "ls-files", "-z", "--", "agents/.agents/skills"], cwd=repo
    ).decode().split("\0")
    return {
        alias.name: alias
        for name in filter(None, names)
        if (alias := repo / name).parent == catalog
        and alias.is_symlink()
        and alias.resolve() == central / alias.name
        and (alias / "SKILL.md").is_file()
    }


def link_skills(home, managed):
    installed = home / ".agents/skills"
    installed.mkdir(parents=True, exist_ok=True)
    if installed.resolve() != installed:
        raise ValueError(f"Expected a real directory at {installed}")

    pending = []
    for name, alias in managed.items():
        target = installed / name
        if target.is_symlink() and target.resolve() == alias.resolve():
            continue
        if target.is_symlink() or (target.exists() and not target.is_dir()):
            raise ValueError(f"Conflicting skill path at {target}")
        if target.exists():
            for local in target.rglob("*"):
                source = alias / local.relative_to(target)
                if local.is_dir() and not local.is_symlink():
                    continue
                if local.is_symlink() or not local.is_file() or not source.is_file():
                    raise ValueError(f"Unexpected file in installed skill at {local}")
                if local.read_bytes() != source.read_bytes():
                    raise ValueError(f"Installed skill has unsynced content at {local}")
        pending.append((target, alias))

    backup = None
    for target, alias in pending:
        saved = None
        if target.exists():
            if backup is None:
                backup = Path(tempfile.mkdtemp(prefix=".dotfiles-skill-backup-", dir=installed.parent))
                print(f"Previous skill directories saved in {backup}", flush=True)
            saved = backup / target.name
            target.rename(saved)
        try:
            target.symlink_to(os.path.relpath(alias, target.parent), target_is_directory=True)
        except OSError:
            if saved is not None:
                saved.rename(target)
            raise
    print(f"Linked {len(pending)} skills to dotfiles", flush=True)


def replace_file(target, source):
    target.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(dir=target.parent, delete=False) as temp:
        staged = Path(temp.name)
    try:
        shutil.copy2(source, staged)
        staged.replace(target)
    finally:
        staged.unlink(missing_ok=True)


def update_skills(repo, managed, names):
    lock_path = repo / "agents/.agents/.skill-lock.json"
    original = lock_path.read_bytes()
    lock = json.loads(original)
    entries = lock["skills"]
    selected = set(names) if names else entries.keys() & managed.keys()
    unknown = selected - (entries.keys() & managed.keys())
    if unknown:
        raise ValueError(f"Skills are not managed and tracked: {', '.join(sorted(unknown))}")
    if not selected:
        print("No dotfiles skills have an upstream update source")
        return

    with tempfile.TemporaryDirectory(prefix="dotfiles-skill-update-") as directory:
        home = Path(directory)
        staged_lock = home / ".agents/.skill-lock.json"
        staged_skills = staged_lock.parent / "skills"
        staged_skills.mkdir(parents=True)
        staged_entries = {name: {**entries[name], "installMode": "symlink"} for name in sorted(selected)}
        for name in staged_entries:
            shutil.copytree(managed[name], staged_skills / name, symlinks=True)
        staged_lock.write_text(json.dumps({**lock, "skills": staged_entries}))

        # Keep npm on the real home for its cache, then isolate the skills process.
        node = subprocess.check_output(["node", "-p", "process.execPath"], text=True).strip()
        node_path = shlex.quote(f"{Path(node).parent}:")
        arguments = shlex.join([
            f"HOME={home}",
            "DISABLE_TELEMETRY=1", "skills", "update", "--global", "--yes",
        ])
        invocation = f'exec /usr/bin/env -i PATH={node_path}"$PATH" {arguments}'
        subprocess.run(["npx", "--yes", "--package=skills@1.9.0", "-c", invocation], cwd=home, check=True)

        updated = json.loads(staged_lock.read_text())["skills"]
        if updated.keys() != staged_entries.keys():
            raise ValueError("Upstream changed which skills are installed. Review upstream removals or renames before updating.")
        changes = {name: entry for name, entry in updated.items() if entry != staged_entries[name]}
        files = []
        for name, entry in changes.items():
            source = staged_skills / name
            if source.is_symlink() or not (source / "SKILL.md").is_file():
                raise ValueError(f"Update did not produce a skill for {name}")
            for path in source.rglob("*"):
                relative = path.relative_to(source)
                if ".cursor-plugin" in relative.parts:
                    continue
                target = managed[name].resolve() / relative
                if path.is_symlink() or target.resolve() != target:
                    raise ValueError(f"Unexpected symlink in {name}/{relative}")
                if path.is_file():
                    if b"uwm" in path.read_bytes().lower():
                        raise ValueError(f"Update contains excluded UWM content in {name}/{relative}")
                    files.append((path, target))
            entry.pop("installMode", None)
            if "installMode" in entries[name]:
                entry["installMode"] = entries[name]["installMode"]
        if lock_path.read_bytes() != original:
            raise ValueError("The skills lock changed during the update. Run update-skills again.")
        for path, target in files:
            replace_file(target, path)
        if changes:
            entries.update(changes)
            staged_lock.write_text(json.dumps(lock, indent=2, ensure_ascii=False))
            shutil.copymode(lock_path, staged_lock)
            replace_file(lock_path, staged_lock)
        print(f"Updated {len(changes)} dotfiles skills")


def main():
    parser = argparse.ArgumentParser(description="Update global skills through dotfiles.")
    parser.add_argument("--link", action="store_true", help="Restore installed links without downloading updates")
    parser.add_argument("skills", nargs="*", help="Update only these managed skills")
    args = parser.parse_args()
    if args.link and args.skills:
        parser.error("--link applies to all managed global skills")
    repo = Path(__file__).resolve().parents[3]
    home = Path.home().resolve()
    try:
        managed = managed_skills(repo)
        link_skills(home, managed)
        if not args.link:
            update_skills(repo, managed, args.skills)
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        parser.exit(1, f"update-skills: {error}\n")


if __name__ == "__main__":
    main()
