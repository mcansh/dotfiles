// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "proxy": "",
  "prettier": {
    "allowed": true
  },
  "which_key": {
    "enabled": false
  },
  "terminal": {
    "dock": "left"
  },
  "code_lens": "on",
  "diff_view_style": "split",
  "cli_default_open_behavior": "new_window",
  "git": {
    "inline_blame": {
      "show_commit_summary": false
    }
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent_servers": {
    "opencode": {
      "type": "registry"
    }
  },
  "edit_predictions": {
    "provider": "zed"
  },
  "context_servers": {

  },
  "git_panel": {
    "sort_by_path": true,
    "tree_view": false,
    "dock": "right"
  },
  "restore_on_startup": "empty_tab",
  "base_keymap": "Atom",
  "agent": {
    "dock": "right",
    "default_profile": "write",
    "inline_assistant_model": {
      "provider": "zed.dev",
      "model": "claude-opus-4-1"
    },
    "default_model": {
      "provider": "zed.dev",
      "model": "claude-opus-4-1"
    },
    "commit_message_model": {
      "provider": "zed.dev",
      "model": "gpt-4o-mini"
    }
  },
  "ui_font_size": 14,
  "buffer_font_size": 12,
  "buffer_line_height": { "custom": 1.7 },
  "ui_font_family": "Berkeley Mono",
  "buffer_font_family": "Berkeley Mono",
  "buffer_font_features": {
    "calt": true,
    "liga": true,
    "dlig": true,
    "ss01": true,
    "ss02": true,
    "ss03": true,
    "ss04": true,
    "ss05": true,
    "ss06": true,
    "ss07": true,
    "ss08": true
  },
  "theme": {
    "mode": "system",
    "light": "Tailwind CSS Light (Enhanced)",
    "dark": "Tailwind CSS Dark (Enhanced)"
  },
  "project_panel": {
    "dock": "right",
    "folder_icons": false,
    "file_icons": false,
    "hide_root": true,
    "sort_mode": "mixed",
    "indent_guides": {
      "show": "always",
    },
  },
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        }
      },
      "enable_lsp_tasks": true
    },
    "biome": {
      "settings": {
        "require_config_file": true
      }
    },
    "prettier": {
      "settings": {
        "require_config_file": true
      }
    },
    "oxc": {
      "settings": {
        "require_config_file": true
      }
    }
  },
  "unnecessary_code_fade": 0.7,
  "code_actions_on_format": {
    "source.fixAll.biome": true,
    "source.organizeImports.biome": true
  },
  "preview_tabs": {
    "enabled": true,
    "enable_preview_from_file_finder": true,
    "enable_keep_preview_on_code_navigation": true
  },
  "languages": {
    "JavaScript": {
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
        "source.organizeImports": true
      },
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--stdin-filepath", "{buffer_path}"]
        }
      }
    },
    "TypeScript": {
      "code_actions_on_format": {
        "source.organizeImports": true,
        "source.fixAll.eslint": true
      },
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--stdin-filepath", "{buffer_path}"]
        }
      }
    },
    "TSX": {
      "code_actions_on_format": {
        "source.organizeImports": true,
        "source.fixAll.eslint": true
      },
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--stdin-filepath", "{buffer_path}"]
        }
      }
    }
  },
  "formatter": {
    "external": {
      "command": "prettier",
      "arguments": ["--stdin-filepath", "{buffer_path}"]
    }
  }
}
