// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "markdown_preview_code_font_family": ".ZedMono",
  "markdown_preview_font_family": ".ZedSans",
  "debugger": {
    "dock": "left"
  },
  "minimum_split_diff_width": 0.0,
  "proxy": "",
  "prettier": {
    "allowed": true
  },
  "which_key": {
    "enabled": false
  },
  "terminal": {
    "dock": "left"
  },
  "code_lens": "on",
  "diff_view_style": "split",
  "cli_default_open_behavior": "new_window",
  "git": {
    "diff_base": "head",
    "inline_blame": {
      "show_commit_summary": false
    }
  },
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "agent_servers": {
    "github-copilot-cli": {
      "default_config_options": {
        "mode": "https://agentclientprotocol.com/protocol/session-modes#agent",
        "model": "auto"
      },
      "favorite_config_option_values": {
        "model": ["gpt-5.3-codex"]
      },
      "type": "registry"
    },
    "codex-acp": {
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    },
    "opencode": {
      "default_config_options": {
        "effort": "max",
        "model": "opencode/deepseek-v4-flash-free"
      },
      "type": "registry"
    }
  },
  "edit_predictions": {
    "provider": "zed"
  },
  "context_servers": {},
  "git_panel": {
    "show_count_badge": true,
    "file_icons": false,
    "status_style": "icon",
    "group_by": "staging",
    "sort_by": "path",
    "tree_view": false,
    "dock": "right"
  },
  "restore_on_startup": "empty_tab",
  "base_keymap": "Atom",
  "agent": {
    "sidebar_side": "right",
    "favorite_models": [
      {
        "provider": "openai-subscribed",
        "model": "gpt-5.6-sol",
        "enable_thinking": true,
        "effort": "low",
        "speed": "fast"
      }
    ],
    "flexible": true,
    "dock": "right",
    "default_profile": "write",
    "inline_assistant_model": {
      "provider": "openai",
      "model": "gpt-5.6-sol"
    },
    "default_model": {
      "speed": "fast",
      "effort": "low",
      "enable_thinking": true,
      "provider": "openai-subscribed",
      "model": "gpt-5.6-sol"
    },
    "commit_message_model": {
      "provider": "openai",
      "model": "gpt-5.6-sol"
    }
  },
  "ui_font_size": 14,
  "buffer_font_size": 12,
  "buffer_line_height": { "custom": 1.7 },
  "ui_font_family": "Berkeley Mono Variable",
  "buffer_font_family": "Berkeley Mono Variable",
  "buffer_font_features": {
    "calt": true,
    "liga": true,
    "dlig": true,
    "ss01": true,
    "ss02": true,
    "ss03": true,
    "ss04": true,
    "ss05": true,
    "ss06": true,
    "ss07": true,
    "ss08": true
  },
  "theme": {
    "mode": "system",
    "light": "Tailwind CSS Light (Enhanced)",
    "dark": "Tailwind CSS Dark (Enhanced)"
  },
  "project_panel": {
    "dock": "right",
    "folder_icons": false,
    "file_icons": false,
    "hide_root": true,
    "sort_mode": "mixed",
    "indent_guides": {
      "show": "always"
    }
  },
  "lsp": {
    "vtsls": {
      "binary": {
        "path": "node_modules/.bin/tsc",
        "arguments": ["--lsp", "--stdio"]
      },
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        }
      },
      "enable_lsp_tasks": true
    }
  },
  "unnecessary_code_fade": 0.7,
  "preview_tabs": {
    "enabled": true,
    "enable_preview_from_file_finder": true,
    "enable_keep_preview_on_code_navigation": true
  },
  "languages": {
    "CSS": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "GraphQL": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "Handlebars": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "HTML": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "JavaScript": {
      "format_on_save": "on",
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
        "source.organizeImports": true
      },
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        },
        {
          "code_action": "source.fixAll.oxc"
        }
      ]
    },
    "JSON": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "JSON5": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "JSONC": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "Less": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "Markdown": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "MDX": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "SCSS": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "TypeScript": {
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
        "source.organizeImports": true
      },
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "TSX": {
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
        "source.organizeImports": true
      },
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "Vue.js": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "YAML": {
      "format_on_save": "on",
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    }
  },
  "formatter": {
    "external": {
      "command": "prettier",
      "arguments": ["--stdin-filepath", "{buffer_path}"]
    }
  }
}
